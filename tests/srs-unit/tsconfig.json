{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "typeRoots": ["../../node_modules/@types"],
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "original/**/*.ts",
    "supplementary/**/*.ts"
  ]
}
