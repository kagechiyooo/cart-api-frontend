{
  "name": "cart-api-frontend-srs-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:srs",
    "test:srs": "vitest run --config vitest.config.ts",
    "test:srs:watch": "vitest --watch --config vitest.config.ts",
    "test:srs:ui": "vitest --watch --ui --config vitest.config.ts --api.host 127.0.0.1 --api.port 51204 --api.strictPort --no-open",
    "test:srs:original": "vitest run --config vitest.config.ts srs-unit/original",
    "test:srs:supplementary": "vitest run --config vitest.config.ts srs-unit/supplementary",
    "typecheck:srs": "tsc --project tsconfig.srs-unit.json"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@vitest/ui": "5.0.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "5.0.3"
  }
}
